# SWAIS VidhyaBharathi — backend env TEMPLATE.
# Copy to `.env` and fill the blanks. `.env` is gitignored — never commit real secrets.

# --- Auth ---
# Generate your own: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Web origin (CORS). Keep 3100 unless you change the web dev port. ---
FRONTEND_ORIGIN=http://localhost:3100

# --- DEMO branch DB (dem_prod on RDS) ---
# Ask the admin for <DB_PASSWORD>.
# NOTE: your machine's public IP must be whitelisted on the RDS security group
# (port 5432) or every query will time out. Get your IP: curl https://checkip.amazonaws.com
DEMO_DATABASE_URL=postgresql+psycopg://swais_app_user:<DB_PASSWORD>@swais-db-test-env.cri2kcc26kxg.ap-south-2.rds.amazonaws.com:5432/dem_prod

# --- Google Sign-In (public client ID — same for everyone) ---
GOOGLE_CLIENT_ID=1020497458196-0ao1jsqgkof4ld7og5h1flj5j0oma4pn.apps.googleusercontent.com

# --- OTP ---
# console = code is returned in the API response (dev/testing, no SMS).
# twilio  = real SMS (fill the 3 TWILIO_ vars below, ask admin).
OTP_DELIVERY_MODE=console
OTP_EXPIRY_MINUTES=5
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
