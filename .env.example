# SWAIS VidhyaBharathi — environment template.
# Copy to backend/.env (backend) and frontend/.env.local (frontend). Never commit real values.

# ============ BACKEND (backend/.env) ============

# --- Auth ---
SECRET_KEY=change-me-generate-with-secrets-token_urlsafe
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# --- Multi-tenancy: ONE database URL per branch (region). Prefix = branch code. ---
# Schools within a branch share tables, separated by school_id. See docs/TENANCY.md.
BVK1_DATABASE_URL=postgresql://user:pass@host:5432/bvk1        # e.g. Vizag  (SCH1..SCH10)
BVK2_DATABASE_URL=postgresql://user:pass@host:5432/bvk2        # e.g. VZM    (SCH20..SCH25)

# --- Central store: cross-branch Nyasa analytics + AI token/billing metering ---
CENTRAL_DATABASE_URL=postgresql://user:pass@host:5432/vb_central

# --- Stateless AI service (separate Node/Gemini service; server-to-server, private) ---
AI_SERVICE_URL=http://localhost:8100
AI_SERVICE_SECRET=shared-secret-must-match-ai-service

# --- S3 (private): Granthalaya books/covers, chapter PDFs, worksheets (presigned URLs) ---
AWS_REGION=ap-south-2
AWS_S3_BUCKET=vidhyabharathi-media
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

FRONTEND_ORIGIN=http://localhost:3000

# ============ FRONTEND (frontend/.env.local) ============
# NEXT_PUBLIC_* are baked in at BUILD time — rebuild after changing them.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
